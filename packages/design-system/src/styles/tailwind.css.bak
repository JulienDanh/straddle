@import "tailwindcss";

@theme {
  /* Surfaces — match :root in global.css */
  --color-bg: #0f1419;
  --color-panel: #1a2230;
  --color-panel2: #222c3d;
  --color-line: #2e3a4d;
  --color-dark: #0c1117;

  /* Text */
  --color-txt: #d8e2ee;
  --color-muted: #8499b5;

  /* Accents */
  --color-accent: #5fd0a8;
  --color-accent2: #6aa6ff;
  --color-warn: #f0b86e;
  --color-bad: #ef6f6f;
  --color-good: #5fd0a8;

  /* Suits */
  --color-spade: #b8c0cc;
  --color-heart: #d33b4a;
  --color-diamond: #2a7fd4;
  --color-club: #2f8f5b;

  /* shadcn semantic tokens */
  --color-background: #0f1419;
  --color-foreground: #d8e2ee;
  --color-card: #1a2230;
  --color-card-foreground: #d8e2ee;
  --color-popover: #1a2230;
  --color-popover-foreground: #d8e2ee;
  --color-primary: #5fd0a8;
  --color-primary-foreground: #0c1117;
  --color-secondary: #222c3d;
  --color-secondary-foreground: #d8e2ee;
  --color-muted-foreground: #8499b5;
  --color-accent-foreground: #d8e2ee;
  --color-destructive: #ef6f6f;
  --color-destructive-foreground: #d8e2ee;
  --color-border: #2e3a4d;
  --color-input: #2e3a4d;
  --color-ring: #5fd0a8;
  --color-radius: 0.5rem;
}

/* Base element styles — replaces global.css for page content */
@layer base {
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: radial-gradient(1200px 800px at 70% -10%, #172033 0, #0f1419 60%);
    color: #d8e2ee;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  /* Section content typography */
  .section h2 { font-size: 20px; border-left: 3px solid #5fd0a8; padding-left: 10px; margin-bottom: 14px; }
  .section h3 { margin: 18px 0 8px; font-size: 15px; color: #6aa6ff; }
  .section p { margin: 10px 0; }
  .section ul { margin: 8px 0; padding-left: 22px; }
  .section li { margin: 5px 0; }

  /* Tables inside sections */
  table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; }
  th, td { border: 1px solid #2e3a4d; padding: 7px 9px; text-align: left; vertical-align: top; }
  th { background: #222c3d; color: #6aa6ff; font-weight: 600; }
  code { background: #0c1117; border: 1px solid #2e3a4d; padding: 1px 6px; border-radius: 5px; font-size: 13px; }

  /* Touch targets */
  .nav-item, .btn, .flip { -webkit-tap-highlight-color: transparent; }
}

/* ---- Range Viewer / RangeGrid / Design System styles ---- */
/* ---- Range Viewer (compact) ---- */
.rv-page {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.rv-loading {
  padding: 40px;
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

/* Top filter bar */
.rv-topbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  padding: 10px 14px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
}
.rv-filter-group {
  display: flex;
  align-items: flex-start;
  gap: 6px;
}
.rv-filter-label {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--muted);
  padding: 4px 0;
  white-space: nowrap;
}
.rv-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}
.rv-chip {
  background: var(--panel2);
  border: 1px solid var(--line);
  color: var(--muted);
  padding: 3px 8px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  transition: 0.1s;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
}
.rv-chip:hover {
  border-color: var(--accent);
  color: var(--txt);
}
.rv-chip.active {
  background: var(--accent);
  color: #0c1117;
  border-color: var(--accent);
}

/* Spot tabs */
.rv-spot-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 2px;
}
.rv-spot-tab {
  background: var(--panel2);
  border: 1px solid var(--line);
  color: var(--muted);
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 11px;
  cursor: pointer;
  transition: 0.1s;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
}
.rv-spot-tab:hover {
  border-color: var(--accent);
  color: var(--txt);
}
.rv-spot-tab.active {
  background: var(--accent);
  color: #0c1117;
  border-color: var(--accent);
  font-weight: 600;
}

/* Solution comparison bar (sticky) */
.rv-sol-bar-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  padding: 6px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
  border-bottom: 1px solid var(--line);
}
.rv-sol-grp {
  display: flex;
  align-items: center;
  gap: 4px;
}
.rv-sol-grp-label {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--accent2);
  white-space: nowrap;
}
.rv-sol-grp-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}
.rv-sol-card {
  background: var(--panel2);
  border: 1px solid var(--line);
  color: var(--muted);
  padding: 3px 9px;
  border-radius: 5px;
  font-size: 11px;
  cursor: pointer;
  transition: 0.1s;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
}
.rv-sol-card:hover {
  border-color: var(--accent);
  color: var(--txt);
}
.rv-sol-card.active {
  background: var(--accent);
  color: #0c1117;
  border-color: var(--accent);
  font-weight: 600;
}

/* Grid + hand detail content */
.rv-content {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  position: relative;
}
.rv-grid-area {
  flex: 1;
  min-width: 560px;
}
.rv-grid-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}
.rv-grid-spot {
  font-size: 14px;
  font-weight: 700;
  color: var(--txt);
}
.rv-grid-sol {
  font-size: 12px;
  color: var(--muted);
}
.rv-grid-stacks {
  font-size: 10px;
  color: var(--accent2);
  font-family: monospace;
}
.rv-grid-herostack {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  background: rgba(95, 208, 168, 0.12);
  border: 1px solid rgba(95, 208, 168, 0.3);
  border-radius: 4px;
  padding: 1px 6px;
  font-family: monospace;
}
.rv-grid-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.rv-grid {
  width: auto;
  border-collapse: collapse;
  margin: 0 auto;
  font-size: 10px;
  table-layout: fixed;
}
.rv-grid th,
.rv-grid td {
  border: 1px solid var(--line);
  text-align: center;
  vertical-align: middle;
  font-size: 10px;
  padding: 2px 0;
  width: 46px;
  height: 44px;
  min-width: 46px;
}
.rv-grid thead th {
  color: var(--muted);
  font-weight: 600;
  font-size: 11px;
  background: var(--panel);
  border-color: var(--line);
  height: 22px;
}
.rv-rowhead {
  color: var(--muted);
  font-weight: 600;
  font-size: 11px;
  background: var(--panel);
}

/* Compact grid — small cells for inline use in course content */
.rv-grid-sm th,
.rv-grid-sm td {
  width: 18px;
  height: 18px;
  min-width: 18px;
  font-size: 0;
  padding: 0;
  border-width: 1px;
}
.rv-grid-sm thead th {
  font-size: 8px;
  height: 14px;
}
.rv-grid-sm .rv-rowhead {
  font-size: 8px;
}
/* Medium grid — cells with hand labels for range previews */
.rv-grid-md th,
.rv-grid-md td {
  width: 28px;
  height: 22px;
  min-width: 28px;
  font-size: 8px;
  padding: 1px 0;
  border-width: 1px;
  text-align: center;
}
.rv-grid-md thead th {
  font-size: 9px;
  height: 16px;
}
.rv-grid-md .rv-rowhead {
  font-size: 9px;
}
.rv-compact {
  display: inline-block;
  overflow-x: auto;
}
.rv-cell {
  background: var(--panel);
  color: var(--muted);
  font-family: monospace;
  user-select: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  line-height: 1.15;
}
.rv-cell-hand {
  font-size: 9px;
  display: block;
}
.rv-cell-freq {
  font-size: 8px;
  opacity: 0.85;
  font-weight: 600;
  display: block;
}
.rv-cell.locked {
  outline: 2px solid var(--accent2);
  outline-offset: -2px;
  position: relative;
}

/* Hand detail panel — absolute so it overlays without layout shift */
.rv-hand-panel {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 14px;
  min-width: 280px;
  max-width: 340px;
  z-index: 20;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}
.rv-hand-panel-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--txt);
  margin-bottom: 2px;
}
.rv-hand-panel-context {
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 10px;
}
.rv-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.rv-action-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.rv-action-label {
  width: 92px;
  font-size: 11px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  font-weight: 600;
  white-space: nowrap;
}
.rv-action-bar {
  flex: 1;
  height: 18px;
  background: var(--panel2);
  border-radius: 4px;
  overflow: hidden;
}
.rv-action-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 4px;
}
.rv-action-pct {
  width: 44px;
  text-align: right;
  font-size: 12px;
  font-weight: 600;
  color: var(--txt);
  font-variant-numeric: tabular-nums;
}

/* Mobile */
@media (max-width: 640px) {
  .rv-topbar { gap: 6px 10px; padding: 8px; }
  .rv-filter-group { flex-direction: column; gap: 3px; }
  .rv-grid th, .rv-grid td { width: 32px; height: 34px; min-width: 32px; font-size: 8px; }
  .rv-content { flex-direction: column; }
  .rv-grid-area { min-width: 0; }
  .rv-hand-panel { min-width: 0; max-width: none; }
}
.rv-chip.disabled {
  opacity: 0.3;
  cursor: not-allowed;
  pointer-events: none;
}
.rv-legend {
  display: flex;
  gap: 14px;
  margin-top: 10px;
  justify-content: center;
  flex-wrap: wrap;
}
.rv-legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--muted);
}
.rv-legend-dot {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 3px;
}

/* Spot-level action summary (headline mix) */
.rv-spot-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 12px;
  margin-bottom: 10px;
  padding: 7px 10px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
}
.rv-summary-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  white-space: nowrap;
}
.rv-summary-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 2px;
}
.rv-summary-name {
  color: var(--muted);
  font-weight: 500;
}
.rv-summary-pct {
  color: var(--txt);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* Hand panel additions: meta, EV, best-action */
.rv-hand-meta {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 12px;
}
.rv-weight-warn {
  color: #f59e0b;
  font-weight: 600;
}
.rv-action-row.best {
  background: rgba(95, 208, 168, 0.08);
  border-radius: 4px;
  padding: 2px 0;
}
.rv-action-row.best .rv-action-label {
  color: var(--accent);
}
.rv-action-ev {
  width: 46px;
  text-align: right;
  font-size: 11px;
  font-weight: 600;
  color: var(--accent2);
  font-variant-numeric: tabular-nums;
  font-family: monospace;
}
.rv-hand-ev-note {
  margin-top: 12px;
  font-size: 10px;
  color: var(--muted);
  border-top: 1px solid var(--line);
  padding-top: 8px;
}
.rv-best-mark {
  color: var(--accent);
  font-weight: 700;
}

/* Grid cell: partial-weight indicator */
.rv-cell-w {
  display: block;
  font-size: 7px;
  color: #f59e0b;
  line-height: 1;
  opacity: 0.9;
}

/* Mobile responsive for page content */
@media (max-width: 760px) {
  .section { padding: 16px 14px; margin: 12px 0; border-radius: 12px; }
  .section h2 { font-size: 18px; }
  .section h3 { font-size: 14px; }
  table { font-size: 12px; }
  th, td { padding: 6px 7px; }
  code { font-size: 12px; }
}
@media (max-width: 380px) {
  .section { padding: 14px 10px; }
  .section h2 { font-size: 16px; }
}
